# Copy this file to .env and fill in your own values.

# Port the server listens on (most hosts set this automatically)
PORT=3000

# Secret key required to view/export waitlist signups.
# Change this to something long and random before deploying.
ADMIN_KEY=changeme

# Vanity starting number added to the real signup count shown on the page
BASE_COUNT=214

# --- Optional: email yourself when someone joins the waitlist ---
# Leave these blank to disable notifications entirely.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_TO=
